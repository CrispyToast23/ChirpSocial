@page "/"
@using ChirpSocial.Business.Services
@using ChirpSocial.Business.Models
@inject ChirpService ChirpService
@inject PeepService PeepService
@inject CommentService CommentService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Chirp Social</PageTitle>

<div class="home-container">
    <div class="trending-peeps">
        <h3>Trending Peeps (24h)</h3>
        @if (topPeeps.Any())
        {
            <ul>
                @foreach (var peep in topPeeps)
                {
                    <li>
                        <button class="peep-filter-btn" @onclick="() => FilterByPeep(peep.Tag)">
                            <strong>@peep.Tag</strong> (@peep.Count)
                        </button>
                    </li>
                }
            </ul>
        }
        else
        {
            <p>No trending peeps yet</p>
        }
        
        @if (!string.IsNullOrEmpty(selectedPeep))
        {
            <div class="filter-active">
                <p>Filtering by: <strong>@selectedPeep</strong></p>
                <button class="btn-secondary btn-small" @onclick="ClearFilter">Clear Filter</button>
            </div>
        }
    </div>

    <div class="chirp-feed">
        <AuthorizeView>
            <Authorized>
                <div class="create-chirp">
                    <h3>Create a Chirp</h3>
                    <form @onsubmit="CreateChirp">
                        <div class="form-group">
                            <textarea @bind="newChirpContent" @bind:event="oninput" placeholder="What's on your mind? (max 123 chars, use <peep> for tags and @@username for mentions)" maxlength="123" rows="3"></textarea>
                            <div class="char-count">@newChirpContent.Length / 123</div>
                        </div>
                        
                        @if (imagePreviewUrl != null)
                        {
                            <div class="image-preview">
                                <img src="@imagePreviewUrl" alt="Preview" />
                                <button type="button" class="remove-image-btn" @onclick="RemoveImage">✕ Remove</button>
                            </div>
                        }
                        
                        <div class="form-actions">
                            <InputFile OnChange="OnImageSelected" accept="image/*" class="file-input" id="imageUpload" />
                            <label for="imageUpload" class="btn-upload">📷 Add Image</label>
                            
                            @if (peepSuggestions.Any())
                            {
                                <div class="peep-suggestions">
                                    <small>Recent peeps:</small>
                                    @foreach (var suggestion in peepSuggestions.Take(10))
                                    {
                                        <button type="button" class="suggestion-btn" @onclick="() => AddPeep(suggestion)">@suggestion</button>
                                    }
                                </div>
                            }
                        </div>
                        
                        <button type="submit" class="btn-primary" disabled="@(string.IsNullOrWhiteSpace(newChirpContent))">Chirp!</button>
                    </form>
                </div>
            </Authorized>
        </AuthorizeView>

        <div class="chirps-list">
            <h3>@(string.IsNullOrEmpty(selectedPeep) ? "Recent Chirps" : $"Chirps with <{selectedPeep}>")</h3>
            @if (chirps.Any())
            {
                @foreach (var chirp in chirps)
                {
                    <div class="chirp-card">
                        <div class="chirp-header">
                            @if (!string.IsNullOrEmpty(chirp.UserProfilePictureUrl))
                            {
                                <img src="@chirp.UserProfilePictureUrl" alt="@chirp.UserName" class="profile-picture-small" />
                            }
                            else
                            {
                                <div class="profile-picture-placeholder-small">
                                    <span>@chirp.UserName.Substring(0, 1).ToUpper()</span>
                                </div>
                            }
                            <a href="/profile/@chirp.UserName" class="user-link">@@@chirp.UserName</a>
                            <span class="chirp-time">@FormatTime(chirp.CreatedAt)</span>
                        </div>
                        
                        @if (editingChirpId == chirp.Id)
                        {
                            <div class="edit-chirp">
                                <form @onsubmit="() => SaveChirpEdit(chirp.Id)">
                                    <textarea @bind="editChirpContent" @bind:event="oninput" maxlength="123" rows="3"></textarea>
                                    <div class="char-count">@editChirpContent.Length / 123</div>
                                    <div class="edit-actions">
                                        <button type="submit" class="btn-primary btn-small" disabled="@(string.IsNullOrWhiteSpace(editChirpContent))">Save</button>
                                        <button type="button" class="btn-secondary btn-small" @onclick="CancelChirpEdit">Cancel</button>
                                    </div>
                                </form>
                            </div>
                        }
                        else
                        {
                            <div class="chirp-content" @onclick="HandleContentClick">
                                @RenderContentWithLinks(chirp.Content)
                            </div>
                        }

                        @if (chirp.ImageUrls.Any())
                        {
                            <div class="chirp-images">
                                @foreach (var imageUrl in chirp.ImageUrls)
                                {
                                    <img src="@imageUrl" alt="Chirp image" class="chirp-image" />
                                }
                            </div>
                        }

                        <div class="chirp-actions">
                            <AuthorizeView>
                                <Authorized>
                                    <button class="like-btn @(chirp.IsLikedByCurrentUser ? "liked" : "")" @onclick="() => ToggleLike(chirp.Id)">
                                        @(chirp.IsLikedByCurrentUser ? "❤️" : "🤍") @chirp.LikeCount
                                    </button>
                                    <button class="comment-btn" @onclick="() => ToggleComments(chirp.Id)">
                                        💬 @chirp.CommentCount
                                    </button>
                                    @if (chirp.UserId == currentUserId && editingChirpId != chirp.Id)
                                    {
                                        <button class="edit-btn" @onclick="() => StartEditChirp(chirp.Id, chirp.Content)">✏️ Edit</button>
                                        <button class="delete-btn" @onclick="() => DeleteChirp(chirp.Id)">🗑️ Delete</button>
                                    }
                                </Authorized>
                                <NotAuthorized>
                                    <span>🤍 @chirp.LikeCount</span>
                                    <span>💬 @chirp.CommentCount</span>
                                </NotAuthorized>
                            </AuthorizeView>
                        </div>

                        @if (expandedChirpId == chirp.Id)
                        {
                            <div class="comments-section">
                                <AuthorizeView>
                                    <Authorized>
                                        <div class="add-comment">
                                            <form @onsubmit="() => AddComment(chirp.Id)">
                                                <textarea @bind="newCommentContent" @bind:event="oninput" placeholder="Write a comment..." maxlength="280" rows="2"></textarea>
                                                <button type="submit" class="btn-primary btn-small" disabled="@(string.IsNullOrWhiteSpace(newCommentContent))">Comment</button>
                                            </form>
                                        </div>
                                    </Authorized>
                                </AuthorizeView>

                                <div class="comments-list">
                                    @if (comments.TryGetValue(chirp.Id, out var chirpComments) && chirpComments.Any())
                                    {
                                        @foreach (var comment in chirpComments)
                                        {
                                            <div class="comment">
                                                <div class="comment-header">
                                                    @if (!string.IsNullOrEmpty(comment.UserProfilePictureUrl))
                                                    {
                                                        <img src="@comment.UserProfilePictureUrl" alt="@comment.UserName" class="profile-picture-tiny" />
                                                    }
                                                    else
                                                    {
                                                        <div class="profile-picture-placeholder-tiny">
                                                            <span>@comment.UserName.Substring(0, 1).ToUpper()</span>
                                                        </div>
                                                    }
                                                    <a href="/profile/@comment.UserName" class="comment-user">@@@comment.UserName</a>
                                                    <span class="comment-time">@FormatTime(comment.CreatedAt)</span>
                                                </div>
                                                
                                                @if (editingCommentId == comment.Id)
                                                {
                                                    <div class="edit-comment">
                                                        <form @onsubmit="() => SaveCommentEdit(comment.Id, chirp.Id)">
                                                            <textarea @bind="editCommentContent" @bind:event="oninput" maxlength="280" rows="2"></textarea>
                                                            <div class="edit-actions">
                                                                <button type="submit" class="btn-primary btn-small" disabled="@(string.IsNullOrWhiteSpace(editCommentContent))">Save</button>
                                                                <button type="button" class="btn-secondary btn-small" @onclick="CancelCommentEdit">Cancel</button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="comment-content" @onclick="HandleContentClick">
                                                        @RenderContentWithLinks(comment.Content)
                                                    </div>
                                                }

                                                @if (comment.UserId == currentUserId && editingCommentId != comment.Id)
                                                {
                                                    <div class="comment-actions">
                                                        <button class="edit-comment-btn" @onclick="() => StartEditComment(comment.Id, comment.Content)">Edit</button>
                                                        <button class="delete-comment-btn" @onclick="() => DeleteComment(comment.Id, chirp.Id)">Delete</button>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <p class="no-comments">No comments yet. Be the first to comment!</p>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                <p>@(string.IsNullOrEmpty(selectedPeep) ? "No chirps yet. Be the first to chirp!" : $"No chirps found with <{selectedPeep}>")</p>
            }
        </div>
    </div>
</div>

@code {
    private List<ChirpDto> chirps = new();
    private List<PeepStatsDto> topPeeps = new();
    private List<string> peepSuggestions = new();
    private Dictionary<int, List<CommentDto>> comments = new();
    private string newChirpContent = string.Empty;
    private string newCommentContent = string.Empty;
    private string editChirpContent = string.Empty;
    private string editCommentContent = string.Empty;
    private string? currentUserId;
    private string? selectedPeep = null;
    private int? expandedChirpId = null;
    private int? editingChirpId = null;
    private int? editingCommentId = null;
    private IBrowserFile? selectedImage = null;
    private string? imagePreviewUrl = null;
    private const long MaxFileSize = 5 * 1024 * 1024; // 5MB

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUserId = authState.User.Identity?.IsAuthenticated == true 
            ? authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value 
            : null;

        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        if (string.IsNullOrEmpty(selectedPeep))
        {
            chirps = await ChirpService.GetRecentChirpsAsync(50, currentUserId);
        }
        else
        {
            chirps = await ChirpService.GetChirpsByPeepAsync(selectedPeep, currentUserId);
        }
        
        topPeeps = await PeepService.GetTopPeepsLast24HoursAsync(5);
        peepSuggestions = await ChirpService.GetPeepSuggestionsAsync();
    }

    private async Task FilterByPeep(string peep)
    {
        selectedPeep = peep.ToLower();
        expandedChirpId = null;
        editingChirpId = null;
        editingCommentId = null;
        await LoadDataAsync();
    }

    private async Task ClearFilter()
    {
        selectedPeep = null;
        await LoadDataAsync();
    }

    private async Task HandleContentClick(MouseEventArgs e)
    {
        var peep = await JS.InvokeAsync<string>("getPeepFromClick", e.ClientX, e.ClientY);
        if (!string.IsNullOrEmpty(peep))
        {
            await FilterByPeep(peep);
        }
    }

    private async Task CreateChirp()
    {
        if (string.IsNullOrWhiteSpace(newChirpContent) || currentUserId == null)
            return;

        var result = await ChirpService.CreateChirpAsync(newChirpContent, currentUserId);
        if (result != null)
        {
            if (selectedImage != null)
            {
                await UploadImageAsync(result.Id);
            }
            
            newChirpContent = string.Empty;
            selectedImage = null;
            imagePreviewUrl = null;
            await LoadDataAsync();
        }
    }

    private void StartEditChirp(int chirpId, string content)
    {
        editingChirpId = chirpId;
        editChirpContent = content;
    }

    private async Task SaveChirpEdit(int chirpId)
    {
        if (string.IsNullOrWhiteSpace(editChirpContent) || currentUserId == null)
            return;

        var result = await ChirpService.UpdateChirpAsync(chirpId, editChirpContent, currentUserId);
        if (result != null)
        {
            editingChirpId = null;
            editChirpContent = string.Empty;
            await LoadDataAsync();
        }
    }

    private void CancelChirpEdit()
    {
        editingChirpId = null;
        editChirpContent = string.Empty;
    }

    private async Task DeleteChirp(int chirpId)
    {
        if (currentUserId == null)
            return;

        var result = await ChirpService.DeleteChirpAsync(chirpId, currentUserId);
        if (result)
        {
            await LoadDataAsync();
        }
    }

    private async Task ToggleLike(int chirpId)
    {
        if (currentUserId == null)
            return;

        await ChirpService.ToggleLikeAsync(chirpId, currentUserId);
        await LoadDataAsync();
    }

    private async Task ToggleComments(int chirpId)
    {
        if (expandedChirpId == chirpId)
        {
            expandedChirpId = null;
        }
        else
        {
            expandedChirpId = chirpId;
            if (!comments.ContainsKey(chirpId))
            {
                var chirpComments = await CommentService.GetCommentsForChirpAsync(chirpId);
                comments[chirpId] = chirpComments;
            }
        }
    }

    private async Task AddComment(int chirpId)
    {
        if (string.IsNullOrWhiteSpace(newCommentContent) || currentUserId == null)
            return;

        var result = await CommentService.CreateCommentAsync(chirpId, newCommentContent, currentUserId);
        if (result != null)
        {
            newCommentContent = string.Empty;
            var chirpComments = await CommentService.GetCommentsForChirpAsync(chirpId);
            comments[chirpId] = chirpComments;
            await LoadDataAsync();
        }
    }

    private void StartEditComment(int commentId, string content)
    {
        editingCommentId = commentId;
        editCommentContent = content;
    }

    private async Task SaveCommentEdit(int commentId, int chirpId)
    {
        if (string.IsNullOrWhiteSpace(editCommentContent) || currentUserId == null)
            return;

        var result = await CommentService.UpdateCommentAsync(commentId, editCommentContent, currentUserId);
        if (result != null)
        {
            editingCommentId = null;
            editCommentContent = string.Empty;
            var chirpComments = await CommentService.GetCommentsForChirpAsync(chirpId);
            comments[chirpId] = chirpComments;
            await LoadDataAsync();
        }
    }

    private void CancelCommentEdit()
    {
        editingCommentId = null;
        editCommentContent = string.Empty;
    }

    private async Task DeleteComment(int commentId, int chirpId)
    {
        if (currentUserId == null)
            return;

        var result = await CommentService.DeleteCommentAsync(commentId, currentUserId);
        if (result)
        {
            var chirpComments = await CommentService.GetCommentsForChirpAsync(chirpId);
            comments[chirpId] = chirpComments;
            await LoadDataAsync();
        }
    }

    private void AddPeep(string peep)
    {
        if (newChirpContent.Length + peep.Length + 2 <= 123)
        {
            newChirpContent += $"<{peep}> ";
        }
    }

    private string FormatTime(DateTime dateTime)
    {
        var timeSpan = DateTime.UtcNow - dateTime;
        if (timeSpan.TotalMinutes < 1) return "just now";
        if (timeSpan.TotalMinutes < 60) return $"{(int)timeSpan.TotalMinutes}m ago";
        if (timeSpan.TotalHours < 24) return $"{(int)timeSpan.TotalHours}h ago";
        if (timeSpan.TotalDays < 7) return $"{(int)timeSpan.TotalDays}d ago";
        return dateTime.ToString("MMM d, yyyy");
    }

    private MarkupString RenderContentWithLinks(string content)
    {
        if (string.IsNullOrEmpty(content))
            return new MarkupString(string.Empty);

        var words = content.Split(' ');
        var result = new System.Text.StringBuilder();

        foreach (var word in words)
        {
            var trimmedWord = word.Trim();
            
            var mentionMatch = System.Text.RegularExpressions.Regex.Match(trimmedWord, @"^@(\w+)(.*)$");
            if (mentionMatch.Success)
            {
                var username = mentionMatch.Groups[1].Value;
                var trailing = mentionMatch.Groups[2].Value;
                result.Append($"<a href=\"/profile/{username}\" class=\"mention-link\">@{username}</a>");
                if (!string.IsNullOrEmpty(trailing))
                {
                    result.Append(System.Net.WebUtility.HtmlEncode(trailing));
                }
                result.Append(" ");
                continue;
            }

            var peepMatch = System.Text.RegularExpressions.Regex.Match(trimmedWord, @"^<([^>]+)>(.*)$");
            if (peepMatch.Success)
            {
                var peepTag = peepMatch.Groups[1].Value;
                var trailing = peepMatch.Groups[2].Value;
                result.Append($"<span class=\"peep-tag-inline clickable\" data-peep=\"{System.Net.WebUtility.HtmlEncode(peepTag)}\" style=\"cursor: pointer;\">&lt;{System.Net.WebUtility.HtmlEncode(peepTag)}&gt;</span>");
                if (!string.IsNullOrEmpty(trailing))
                {
                    result.Append(System.Net.WebUtility.HtmlEncode(trailing));
                }
                result.Append(" ");
                continue;
            }

            result.Append(System.Net.WebUtility.HtmlEncode(word));
            result.Append(" ");
        }

        return new MarkupString(result.ToString().TrimEnd());
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.GetMultipleFiles(1).FirstOrDefault();
        if (file != null)
        {
            if (file.Size > MaxFileSize)
            {
                await JS.InvokeVoidAsync("alert", "File size exceeds the 5MB limit.");
                return;
            }

            selectedImage = file;

            var buffer = new byte[file.Size];
            await file.OpenReadStream(MaxFileSize).ReadAsync(buffer);

            imagePreviewUrl = $"data:image/png;base64,{Convert.ToBase64String(buffer)}";
        }
    }

    private void ClearImage()
    {
        selectedImage = null;
        imagePreviewUrl = null;
    }

    private async Task OnImageSelected(InputFileChangeEventArgs e)
    {
        selectedImage = e.File;
        
        if (selectedImage != null)
        {
            if (selectedImage.Size > MaxFileSize)
            {
                selectedImage = null;
                return;
            }

            var buffer = new byte[selectedImage.Size];
            await selectedImage.OpenReadStream(MaxFileSize).ReadAsync(buffer);
            var base64 = Convert.ToBase64String(buffer);
            imagePreviewUrl = $"data:{selectedImage.ContentType};base64,{base64}";
        }
    }

    private void RemoveImage()
    {
        selectedImage = null;
        imagePreviewUrl = null;
    }

    private async Task UploadImageAsync(int chirpId)
    {
        if (selectedImage == null || currentUserId == null)
            return;

        try
        {
            var buffer = new byte[selectedImage.Size];
            await selectedImage.OpenReadStream(MaxFileSize).ReadAsync(buffer);

            await ChirpService.AddImageToChirpAsync(
                chirpId, 
                selectedImage.Name, 
                buffer, 
                selectedImage.ContentType, 
                selectedImage.Size, 
                currentUserId);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.error", $"Failed to upload image: {ex.Message}");
        }
    }
}
