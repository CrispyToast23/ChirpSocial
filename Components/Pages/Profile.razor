@page "/profile/{username}"
@using ChirpSocial.Business.Services
@using ChirpSocial.Business.Models
@using ChirpSocial.Data
@using Microsoft.AspNetCore.Identity
@inject UserProfileService ProfileService
@inject ChirpService ChirpService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>@Username - Profile</PageTitle>

@if (profile != null)
{
    <div class="profile-container">
        <div class="profile-header">
            <div class="profile-picture-section">
                @if (!string.IsNullOrEmpty(profile.ProfilePictureUrl))
                {
                    <img src="@profile.ProfilePictureUrl" alt="@profile.UserName" class="profile-picture-large" />
                }
                else
                {
                    <div class="profile-picture-placeholder-large">
                        <span>@profile.UserName.Substring(0, 1).ToUpper()</span>
                    </div>
                }
                @if (isOwnProfile)
                {
                    <div class="profile-picture-upload">
                        <InputFile OnChange="OnProfilePictureSelected" accept="image/*" class="file-input" id="profilePictureUpload" />
                        <label for="profilePictureUpload" class="btn-upload-small">📷 Change Picture</label>
                    </div>
                }
            </div>
            <div class="profile-info">
                @if (isEditingUsername)
                {
                    <div class="username-edit">
                        <EditForm Model="usernameEdit" OnValidSubmit="SaveUsername" Context="editFormContext">
                            <InputText @bind-Value="usernameEdit" placeholder="Enter new username" maxlength="20" />
                            <button type="submit" class="btn-primary btn-small">Save</button>
                            <button type="button" class="btn-secondary btn-small" @onclick="CancelUsernameEdit">Cancel</button>
                        </EditForm>
                        @if (!string.IsNullOrEmpty(usernameError))
                        {
                            <p class="error-message">@usernameError</p>
                        }
                    </div>
                }
                else
                {
                    <h2>@@@profile.UserName</h2>
                }
                @if (isOwnProfile)
                {
                    @if (!isEditingUsername)
                    {
                        <button class="btn-secondary" @onclick="ToggleEditUsername">Change Username</button>
                    }
                    <button class="btn-secondary" @onclick="ToggleEditBio">@(isEditingBio ? "Cancel" : "Edit Bio")</button>
                }
            </div>
        </div>

        @if (isEditingBio)
        {
            <div class="bio-edit">
                <EditForm Model="bioEdit" OnValidSubmit="SaveBio" Context="editFormContext">
                    <InputTextArea @bind-Value="bioEdit" placeholder="Tell us about yourself..." rows="3" maxlength="200" />
                    <button type="submit" class="btn-primary">Save</button>
                </EditForm>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(profile.Bio))
        {
            <div class="bio">
                <p>@profile.Bio</p>
            </div>
        }

        <div class="profile-stats">
            <div class="stat">
                <strong>@profile.TotalChirps</strong>
                <span>Chirps</span>
            </div>
            <div class="stat">
                <strong>@profile.LikesReceived</strong>
                <span>Likes Received</span>
            </div>
            <div class="stat">
                <strong>@profile.LikesGiven</strong>
                <span>Likes Given</span>
            </div>
        </div>

        <div class="recent-chirps">
            <h3>Recent Chirps</h3>
            @if (profile.RecentChirps.Any())
            {
                @foreach (var chirp in profile.RecentChirps)
                {
                    <div class="chirp-card">
                        <div class="chirp-header">
                            <span class="chirp-time">@FormatTime(chirp.CreatedAt)</span>
                        </div>
                        <div class="chirp-content">@chirp.Content</div>
                        @if (chirp.Peeps.Any())
                        {
                            <div class="chirp-peeps">
                                @foreach (var peep in chirp.Peeps)
                                {
                                    <span class="peep-tag">@peep</span>
                                }
                            </div>
                        }
                        <div class="chirp-actions">
                            <span>🤍 @chirp.LikeCount</span>
                            @if (isOwnProfile)
                            {
                                <button class="delete-btn" @onclick="() => DeleteChirp(chirp.Id)">Delete</button>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <p>No chirps yet.</p>
            }
        </div>
    </div>
}
else if (loading)
{
    <p>Loading profile...</p>
}
else
{
    <p>User not found.</p>
}

@code {
    [Parameter]
    public string Username { get; set; } = string.Empty;

    private UserProfileDto? profile;
    private bool loading = true;
    private bool isOwnProfile = false;
    private bool isEditingBio = false;
    private string bioEdit = string.Empty;
    private string? currentUserId;
    private IBrowserFile? selectedProfilePicture = null;
    private const long MaxProfilePictureSize = 2 * 1024 * 1024; // 2MB
    private bool isEditingUsername = false;
    private string usernameEdit = string.Empty;
    private string? usernameError = null;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUserId = authState.User.Identity?.IsAuthenticated == true 
            ? authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value 
            : null;

        await LoadProfileAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadProfileAsync();
    }

    private async Task LoadProfileAsync()
    {
        loading = true;
        var user = await UserManager.FindByNameAsync(Username);
        
        if (user != null)
        {
            profile = await ProfileService.GetUserProfileAsync(user.Id, currentUserId);
            isOwnProfile = currentUserId == user.Id;
        }
        else
        {
            profile = null;
        }

        loading = false;
    }

    private void ToggleEditBio()
    {
        isEditingBio = !isEditingBio;
        if (isEditingBio)
        {
            bioEdit = profile?.Bio ?? string.Empty;
        }
    }

    private void ToggleEditUsername()
    {
        isEditingUsername = !isEditingUsername;
        usernameError = null;
        if (isEditingUsername)
        {
            usernameEdit = profile?.UserName ?? string.Empty;
        }
    }

    private void CancelUsernameEdit()
    {
        isEditingUsername = false;
        usernameError = null;
    }

    private async Task SaveUsername()
    {
        if (currentUserId != null && !string.IsNullOrWhiteSpace(usernameEdit))
        {
            var result = await ProfileService.UpdateUsernameAsync(currentUserId, usernameEdit);
            if (result.Success)
            {
                isEditingUsername = false;
                usernameError = null;
                // Redirect to new profile URL
                NavigationManager.NavigateTo($"/profile/{usernameEdit}", forceLoad: true);
            }
            else
            {
                usernameError = result.ErrorMessage ?? "Failed to update username";
            }
        }
    }

    private async Task SaveBio()
    {
        if (currentUserId != null)
        {
            await ProfileService.UpdateBioAsync(currentUserId, bioEdit);
            await LoadProfileAsync();
            isEditingBio = false;
        }
    }

    private async Task DeleteChirp(int chirpId)
    {
        if (currentUserId == null)
            return;

        var result = await ChirpService.DeleteChirpAsync(chirpId, currentUserId);
        if (result)
        {
            await LoadProfileAsync();
        }
    }

    private string FormatTime(DateTime dateTime)
    {
        var timeSpan = DateTime.UtcNow - dateTime;
        if (timeSpan.TotalMinutes < 1) return "just now";
        if (timeSpan.TotalMinutes < 60) return $"{(int)timeSpan.TotalMinutes}m ago";
        if (timeSpan.TotalHours < 24) return $"{(int)timeSpan.TotalHours}h ago";
        if (timeSpan.TotalDays < 7) return $"{(int)timeSpan.TotalDays}d ago";
        return dateTime.ToString("MMM d, yyyy");
    }

    private async Task OnProfilePictureSelected(InputFileChangeEventArgs e)
    {
        selectedProfilePicture = e.File;
        
        if (selectedProfilePicture != null && currentUserId != null)
        {
            if (selectedProfilePicture.Size > MaxProfilePictureSize)
            {
                // TODO: Show error message
                selectedProfilePicture = null;
                return;
            }

            try
            {
                var buffer = new byte[selectedProfilePicture.Size];
                await selectedProfilePicture.OpenReadStream(MaxProfilePictureSize).ReadAsync(buffer);

                await ProfileService.UpdateProfilePictureAsync(currentUserId, buffer, selectedProfilePicture.ContentType);
                await LoadProfileAsync();
            }
            catch
            {
                // TODO: Handle upload errors
            }
        }
    }
}
